# Copie para .env e ajuste conforme necessário

# Database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/imobiliaria?schema=public"

# API
PORT=3001

# CORS (produção)
# Lista de origins separadas por vírgula (ex: http://localhost:3000,https://app.suaempresa.com)
# Em desenvolvimento, o CORS fica liberado.
CORS_ORIGIN="http://localhost:3000"

# Auth
JWT_SECRET="change_me"
JWT_EXPIRES_IN="1d"

# Sicoob (opcional)
SICOOB_BASE_URL=
SICOOB_TOKEN=

Definir SMTP real na sessão atual
$env:SMTP_HOST="smtp.seu-provedor.com"
$env:SMTP_PORT="587"
$env:SMTP_USER="seu_usuario_smtp"
$env:SMTP_PASS="sua_senha_smtp"
$env:SMTP_FROM="Seu Nome no-reply@seudominio.com"
$env:PASSWORD_RESET_URL="http://localhost:3000/reset-password"