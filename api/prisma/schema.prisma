generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  AGENT
  VIEWER
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  PHONE
  WALK_IN
  OTHER
}

enum LeadInterestType {
  RENT
  BUY
  SELL
  PROPERTY_MANAGEMENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  PROPERTY_VISIT
  STATUS_CHANGE
}

enum PersonType {
  INDIVIDUAL
  COMPANY
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

enum BankAccountType {
  CHECKING
  SAVINGS
}

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL
  LAND
  WAREHOUSE
  OTHER
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  UNDER_MAINTENANCE
  UNAVAILABLE
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

enum DepositType {
  CASH
  BANK_GUARANTEE
  INSURANCE
  GUARANTOR
}

enum ReadjustmentIndex {
  IGPM
  IPCA
  INPC
  OTHER
}

enum PaymentType {
  RENT
  CONDOMINIUM
  IPTU
  WATER
  ELECTRICITY
  GAS
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  PIX
  BANK_TRANSFER
  BOLETO
  CASH
  CHECK
}

enum LandlordPaymentStatus {
  PENDING
  PAID
}

enum InsuranceType {
  FIRE
  RENTAL_GUARANTEE
  CONTENT
  COMPREHENSIVE
}

enum InsuranceStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InspectionType {
  ENTRY
  EXIT
  PERIODIC
  MAINTENANCE
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Condition {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum ItemCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  NOT_APPLICABLE
}

enum DocumentEntityType {
  LEAD
  TENANT
  LANDLORD
  PROPERTY
  LEASE
  INSURANCE
  INSPECTION
}

enum DocumentType {
  CONTRACT
  ID_DOCUMENT
  PROOF_OF_INCOME
  PROOF_OF_ADDRESS
  PHOTO
  REPORT
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────────
// INFRASTRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  cpf           String?  @unique
  passwordHash  String   @map("password_hash")
  role          UserRole @default(AGENT)
  avatarUrl     String?  @map("avatar_url")
  phone         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  assignedLeads      Lead[]             @relation("AssignedLeads")
  leadActivities     LeadActivity[]
  leadStatusHistory  LeadStatusHistory[]
  createdLeases      Lease[]            @relation("CreatedLeases")
  createdInspections Inspection[]       @relation("CreatedInspections")
  uploadedDocuments  Document[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM
// ─────────────────────────────────────────────────────────────────────────────

model Lead {
  id                 String           @id @default(uuid())
  name               String
  email              String
  phone              String
  cpfCnpj            String?          @map("cpf_cnpj")
  source             LeadSource
  interestType       LeadInterestType @map("interest_type")
  status             LeadStatus       @default(NEW)
  notes              String?
  assignedToId       String?          @map("assigned_to_id")
  expectedBudgetMin  Decimal?         @map("expected_budget_min") @db.Decimal(12, 2)
  expectedBudgetMax  Decimal?         @map("expected_budget_max") @db.Decimal(12, 2)
  preferredRegions   String[]         @map("preferred_regions")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  assignedTo    User?               @relation("AssignedLeads", fields: [assignedToId], references: [id])
  activities    LeadActivity[]
  statusHistory LeadStatusHistory[]

  @@map("leads")
}

model LeadActivity {
  id          String           @id @default(uuid())
  leadId      String           @map("lead_id")
  userId      String           @map("user_id")
  type        LeadActivityType
  description String
  scheduledAt DateTime?        @map("scheduled_at")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("lead_activities")
}

model LeadStatusHistory {
  id             String     @id @default(uuid())
  leadId         String     @map("lead_id")
  userId         String     @map("user_id")
  previousStatus LeadStatus @map("previous_status")
  newStatus      LeadStatus @map("new_status")
  reason         String?
  createdAt      DateTime   @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("lead_status_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// PESSOAS
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id                  String       @id @default(uuid())
  personType          PersonType   @map("person_type")
  name                String
  cpf                 String?      @unique
  cnpj                String?      @unique
  rg                  String?
  email               String
  phone               String
  secondaryPhone      String?      @map("secondary_phone")
  birthDate           DateTime?    @map("birth_date") @db.Date
  profession          String?
  monthlyIncome       Decimal?     @map("monthly_income") @db.Decimal(12, 2)
  employerName        String?      @map("employer_name")
  employerPhone       String?      @map("employer_phone")
  addressStreet       String       @map("address_street")
  addressNumber       String       @map("address_number")
  addressComplement   String?      @map("address_complement")
  addressNeighborhood String       @map("address_neighborhood")
  addressCity         String       @map("address_city")
  addressState        String       @map("address_state") @db.Char(2)
  addressPostalCode   String       @map("address_postal_code")
  status              PersonStatus @default(ACTIVE)
  notes               String?
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  emergencyContacts TenantEmergencyContact[]
  leases            Lease[]

  @@map("tenants")
}

model TenantEmergencyContact {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  name         String
  relationship String
  phone        String
  email        String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_emergency_contacts")
}

model Landlord {
  id                  String          @id @default(uuid())
  personType          PersonType      @map("person_type")
  name                String
  cpf                 String?         @unique
  cnpj                String?         @unique
  rg                  String?
  email               String
  phone               String
  secondaryPhone      String?         @map("secondary_phone")
  bankName            String?         @map("bank_name")
  bankAgency          String?         @map("bank_agency")
  bankAccount         String?         @map("bank_account")
  bankAccountType     BankAccountType? @map("bank_account_type")
  pixKey              String?         @map("pix_key")
  addressStreet       String          @map("address_street")
  addressNumber       String          @map("address_number")
  addressComplement   String?         @map("address_complement")
  addressNeighborhood String          @map("address_neighborhood")
  addressCity         String          @map("address_city")
  addressState        String          @map("address_state") @db.Char(2)
  addressPostalCode   String          @map("address_postal_code")
  commissionPercentage Decimal        @default(10) @map("commission_percentage") @db.Decimal(5, 2)
  status              PersonStatus    @default(ACTIVE)
  notes               String?
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  properties       Property[]
  leases           Lease[]
  landlordPayments LandlordPayment[]

  @@map("landlords")
}

// ─────────────────────────────────────────────────────────────────────────────
// IMÓVEIS
// ─────────────────────────────────────────────────────────────────────────────

model Property {
  id                  String         @id @default(uuid())
  landlordId          String         @map("landlord_id")
  code                String         @unique
  propertyType        PropertyType   @map("property_type")
  status              PropertyStatus @default(AVAILABLE)
  addressStreet       String         @map("address_street")
  addressNumber       String         @map("address_number")
  addressComplement   String?        @map("address_complement")
  addressNeighborhood String         @map("address_neighborhood")
  addressCity         String         @map("address_city")
  addressState        String         @map("address_state") @db.Char(2)
  addressPostalCode   String         @map("address_postal_code")
  totalArea           Decimal        @map("total_area") @db.Decimal(10, 2)
  builtArea           Decimal?       @map("built_area") @db.Decimal(10, 2)
  bedrooms            Int            @default(0)
  bathrooms           Int            @default(0)
  parkingSpaces       Int            @default(0) @map("parking_spaces")
  floor               Int?
  hasElevator         Boolean        @default(false) @map("has_elevator")
  isFurnished         Boolean        @default(false) @map("is_furnished")
  allowsPets          Boolean        @default(false) @map("allows_pets")
  rentValue           Decimal        @map("rent_value") @db.Decimal(12, 2)
  condominiumFee      Decimal?       @map("condominium_fee") @db.Decimal(12, 2)
  iptuValue           Decimal?       @map("iptu_value") @db.Decimal(12, 2)
  description         String?
  features            String[]
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  landlord    Landlord        @relation(fields: [landlordId], references: [id])
  images      PropertyImage[]
  leases      Lease[]
  inspections Inspection[]
  insurances  Insurance[]

  @@map("properties")
}

model PropertyImage {
  id          String   @id @default(uuid())
  propertyId  String   @map("property_id")
  url         String
  description String?
  isCover     Boolean  @default(false) @map("is_cover")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_images")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTRATOS
// ─────────────────────────────────────────────────────────────────────────────

model Lease {
  id                        String            @id @default(uuid())
  code                      String            @unique
  propertyId                String            @map("property_id")
  tenantId                  String            @map("tenant_id")
  landlordId                String            @map("landlord_id")
  status                    LeaseStatus       @default(DRAFT)
  startDate                 DateTime          @map("start_date") @db.Date
  endDate                   DateTime          @map("end_date") @db.Date
  rentValue                 Decimal           @map("rent_value") @db.Decimal(12, 2)
  condominiumFee            Decimal?          @map("condominium_fee") @db.Decimal(12, 2)
  iptuValue                 Decimal?          @map("iptu_value") @db.Decimal(12, 2)
  paymentDueDay             Int               @map("payment_due_day")
  depositAmount             Decimal?          @map("deposit_amount") @db.Decimal(12, 2)
  depositType               DepositType?      @map("deposit_type")
  readjustmentIndex         ReadjustmentIndex @map("readjustment_index")
  readjustmentPeriodMonths  Int               @default(12) @map("readjustment_period_months")
  lateFeePercentage         Decimal           @default(2) @map("late_fee_percentage") @db.Decimal(5, 2)
  lateInterestPercentage    Decimal           @default(1) @map("late_interest_percentage") @db.Decimal(5, 2)
  gracePeriodDays           Int               @default(0) @map("grace_period_days")
  notes                     String?
  cancellationReason        String?           @map("cancellation_reason")
  cancelledAt               DateTime?         @map("cancelled_at")
  createdById               String            @map("created_by_id")
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")

  property         Property          @relation(fields: [propertyId], references: [id])
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  landlord         Landlord          @relation(fields: [landlordId], references: [id])
  createdBy        User              @relation("CreatedLeases", fields: [createdById], references: [id])
  guarantors       LeaseGuarantor[]
  payments         Payment[]
  landlordPayments LandlordPayment[]
  inspections      Inspection[]
  insurances       Insurance[]

  @@map("leases")
}

model LeaseGuarantor {
  id                  String   @id @default(uuid())
  leaseId             String   @map("lease_id")
  name                String
  cpf                 String
  rg                  String?
  email               String
  phone               String
  profession          String?
  monthlyIncome       Decimal? @map("monthly_income") @db.Decimal(12, 2)
  addressStreet       String   @map("address_street")
  addressNumber       String   @map("address_number")
  addressComplement   String?  @map("address_complement")
  addressNeighborhood String   @map("address_neighborhood")
  addressCity         String   @map("address_city")
  addressState        String   @map("address_state") @db.Char(2)
  addressPostalCode   String   @map("address_postal_code")
  spouseName          String?  @map("spouse_name")
  spouseCpf           String?  @map("spouse_cpf")

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@map("lease_guarantors")
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCEIRO
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id             String        @id @default(uuid())
  leaseId        String        @map("lease_id")
  type           PaymentType
  referenceMonth DateTime      @map("reference_month") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  baseAmount     Decimal       @map("base_amount") @db.Decimal(12, 2)
  lateFee        Decimal       @default(0) @map("late_fee") @db.Decimal(12, 2)
  interest       Decimal       @default(0) @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?     @map("paid_at")
  paidAmount     Decimal?      @map("paid_amount") @db.Decimal(12, 2)
  paymentMethod  PaymentMethod? @map("payment_method")
  boletoUrl      String?       @map("boleto_url")
  boletoCode     String?       @map("boleto_code")
  boletoId       String?       @map("boleto_id")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  lease Lease @relation(fields: [leaseId], references: [id])

  @@map("payments")
}

model LandlordPayment {
  id             String                @id @default(uuid())
  landlordId     String                @map("landlord_id")
  leaseId        String                @map("lease_id")
  referenceMonth DateTime              @map("reference_month") @db.Date
  grossAmount    Decimal               @map("gross_amount") @db.Decimal(12, 2)
  commissionAmount Decimal             @map("commission_amount") @db.Decimal(12, 2)
  deductions     Decimal               @default(0) @db.Decimal(12, 2)
  netAmount      Decimal               @map("net_amount") @db.Decimal(12, 2)
  status         LandlordPaymentStatus @default(PENDING)
  paidAt         DateTime?             @map("paid_at")
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at")

  landlord Landlord @relation(fields: [landlordId], references: [id])
  lease    Lease    @relation(fields: [leaseId], references: [id])

  @@map("landlord_payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// SEGUROS
// ─────────────────────────────────────────────────────────────────────────────

model Insurance {
  id             String          @id @default(uuid())
  leaseId        String?         @map("lease_id")
  propertyId     String          @map("property_id")
  type           InsuranceType
  insurerName    String          @map("insurer_name")
  policyNumber   String          @map("policy_number")
  coverageAmount Decimal         @map("coverage_amount") @db.Decimal(14, 2)
  premiumAmount  Decimal         @map("premium_amount") @db.Decimal(12, 2)
  startDate      DateTime        @map("start_date") @db.Date
  endDate        DateTime        @map("end_date") @db.Date
  status         InsuranceStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  lease    Lease?   @relation(fields: [leaseId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@map("insurances")
}

// ─────────────────────────────────────────────────────────────────────────────
// VISTORIAS
// ─────────────────────────────────────────────────────────────────────────────

model Inspection {
  id               String           @id @default(uuid())
  propertyId       String           @map("property_id")
  leaseId          String?          @map("lease_id")
  type             InspectionType
  status           InspectionStatus @default(SCHEDULED)
  scheduledDate    DateTime         @map("scheduled_date") @db.Date
  completedDate    DateTime?        @map("completed_date") @db.Date
  inspectorName    String?          @map("inspector_name")
  generalCondition Condition?       @map("general_condition")
  observations     String?
  createdById      String           @map("created_by_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  property  Property         @relation(fields: [propertyId], references: [id])
  lease     Lease?           @relation(fields: [leaseId], references: [id])
  createdBy User             @relation("CreatedInspections", fields: [createdById], references: [id])
  items     InspectionItem[]

  @@map("inspections")
}

model InspectionItem {
  id           String        @id @default(uuid())
  inspectionId String        @map("inspection_id")
  room         String
  item         String
  condition    ItemCondition
  observations String?
  photos       String[]

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@map("inspection_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// DOCUMENTOS
// ─────────────────────────────────────────────────────────────────────────────

model Document {
  id           String             @id @default(uuid())
  entityType   DocumentEntityType @map("entity_type")
  entityId     String             @map("entity_id")
  name         String
  type         DocumentType
  fileUrl      String             @map("file_url")
  fileSize     Int                @map("file_size")
  mimeType     String             @map("mime_type")
  uploadedById String             @map("uploaded_by_id")
  createdAt    DateTime           @default(now()) @map("created_at")

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
  @@map("documents")
}


